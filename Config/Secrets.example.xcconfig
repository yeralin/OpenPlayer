// Template for Config/Secrets.xcconfig, which is gitignored:
//
//     cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
//
// Values are copied into the app's Info.plist at build time, so anyone with
// the .ipa can read them. Use credentials that only protect your own server.
//
// xcconfig syntax: no quotes; "//" starts a comment and "$(" starts a
// variable reference. To use a literal "//" write "/$()/".
OPENPLAYER_SERVER_USERNAME = your-username
OPENPLAYER_SERVER_PASSWORD = your-password
